{:paths ["src"]
 :deps {io.github.kotoba-lang/org-ietf-sd-jwt
        {:git/url "https://github.com/kotoba-lang/org-ietf-sd-jwt.git"
         :git/sha "8e575ed7d26c03793e89792d8ba36286f5e6d2b3"}
        io.github.kotoba-lang/org-ietf-jws
        {:git/url "https://github.com/kotoba-lang/org-ietf-jws.git"
         :git/sha "6931dd3125ff1d933d895ba3478002da831c1196"}
        io.github.kotoba-lang/io-multiformats
        {:git/url "https://github.com/kotoba-lang/io-multiformats.git"
         :git/sha "37843825a77bc6b74f4a1882471d252f6f931f58"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      org.clojure/data.json {:mvn/version "2.5.1"}
                      io.github.kotoba-lang/org-ietf-ed25519
                      {:git/url "https://github.com/kotoba-lang/org-ietf-ed25519.git"
                       :git/sha "c1ba8322a33b668da1311ca69a8cdde3c7981b52"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}
  :dev {:override-deps
        {io.github.kotoba-lang/org-ietf-sd-jwt {:local/root "../org-ietf-sd-jwt"}
         io.github.kotoba-lang/org-ietf-jws {:local/root "../org-ietf-jws"}
         io.github.kotoba-lang/io-multiformats {:local/root "../io-multiformats"}
         io.github.kotoba-lang/org-ietf-ed25519 {:local/root "../org-ietf-ed25519"}}}}}
